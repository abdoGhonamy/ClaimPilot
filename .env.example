# Copy to .env (git-ignored) and edit as needed.
#   cp .env.example .env
# Host ports differ from the app defaults (5432/6379/11434/5028) so the
# documented local stack and this container stack can coexist.

POSTGRES_DB=claimpilot
POSTGRES_USER=claimpilot
POSTGRES_PASSWORD=claimpilot
POSTGRES_PORT=5433
REDIS_PORT=6380
OLLAMA_PORT=11435
API_PORT=8080

# Use a long random value in real deployments.
JWT_KEY=ClaimPilotDevSigningKeyChangeMe_0123456789ABCDEF
ASPNETCORE_ENVIRONMENT=Development